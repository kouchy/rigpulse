# RigPulse — Web Directory Access Control

# Forbid direct access to sensitive configuration, template, and CLI scripts
<FilesMatch "^(config.*\.php|bootstrap\.php|update_password\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
